class Solution {
public:
    ListNode* removeElements(ListNode* head, int val) {
        ListNode dummy(0,head);
        ListNode* prev=&dummy;
        ListNode* cur=head;
        while(cur!=nullptr){
            ListNode* nxt=cur->next;
            if(cur->val==val){
                prev->next=nxt;
                delete cur;
            }
            else{
                prev=cur;
            }
            cur=nxt;
        }
        return dummy.next;
    }
};   
