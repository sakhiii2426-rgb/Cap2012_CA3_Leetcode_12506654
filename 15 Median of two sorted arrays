
class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {

        int m = nums1.size();
        int n = nums2.size();

        int arr[2000];
        int k = 0;

        for(int i = 0; i < m; i++) {
            arr[k] = nums1[i];
            k++;
        }

        for(int i = 0; i < n; i++) {
            arr[k] = nums2[i];
            k++;
        }

        sort(arr, arr + k);

        if(k % 2 == 1) {
            return arr[k / 2];
        }
        else {
            return (arr[k / 2 - 1] + arr[k / 2]) / 2.0;
        }
    }
};
